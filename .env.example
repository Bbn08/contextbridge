# Local is the safe default and requires no AWS configuration.
CONTEXTBRIDGE_STORAGE=local

# Required only when CONTEXTBRIDGE_STORAGE=aws.
CONTEXTBRIDGE_DYNAMODB_TABLE=contextbridge-m2
CONTEXTBRIDGE_S3_BUCKET=replace-with-your-bucket

# Optional standard AWS SDK region override.
# The SDK otherwise uses AWS_REGION/AWS_DEFAULT_REGION, shared profiles,
# IAM Identity Center, container credentials, or instance role credentials.
AWS_REGION=us-east-1
